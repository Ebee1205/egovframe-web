<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE form-validation PUBLIC
    "-//Apache Software Foundation//DTD Commons Validator Rules Configuration 1.1//EN"
    "http://jakarta.apache.org/commons/dtds/validator_1_1.dtd">

<form-validation>
    <formset>
        <form name="regDetailVO">
            <field property="parentRegId" depends="long">
                <arg0 key="reg.parentRegId"/>
            </field>
            <field property="name" depends="required,maxlength">
                <arg0 key="reg.name"/>
                <arg1 name="maxlength" key="100" resource="false"/>
                <var><var-name>maxlength</var-name><var-value>100</var-value></var>
            </field>
            <field property="code" depends="required,maxlength">
                <arg0 key="reg.code"/>
                <arg1 name="maxlength" key="20" resource="false"/>
                <var><var-name>maxlength</var-name><var-value>20</var-value></var>
            </field>
        </form>
    </formset>
</form-validation>
