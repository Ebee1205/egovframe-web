<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE form-validation PUBLIC
    "-//Apache Software Foundation//DTD Commons Validator Rules Configuration 1.1//EN"
    "http://jakarta.apache.org/commons/dtds/validator_1_1.dtd">

<form-validation>
    <formset>
        <!-- 수정 폼: createdBy, cDate, uDate는 기존 데이터/DB에서 관리한다. -->
        <form name="eventVO">
            <field property="eid" depends="required,long">
                <arg0 key="이벤트 ID" resource="false"/>
            </field>
            <field property="title" depends="required,maxlength">
                <arg0 key="이벤트 제목" resource="false"/>
                <arg1 name="maxlength" key="300" resource="false"/>
                <var><var-name>maxlength</var-name><var-value>300</var-value></var>
            </field>
            <field property="ctg" depends="required,maxlength">
                <arg0 key="이벤트 카테고리" resource="false"/>
                <arg1 name="maxlength" key="20" resource="false"/>
                <var><var-name>maxlength</var-name><var-value>20</var-value></var>
            </field>
            <field property="status" depends="required,maxlength">
                <arg0 key="이벤트 상태" resource="false"/>
                <arg1 name="maxlength" key="20" resource="false"/>
                <var><var-name>maxlength</var-name><var-value>20</var-value></var>
            </field>
            <field property="rid" depends="required,long">
                <arg0 key="이벤트 지역 ID" resource="false"/>
            </field>

            <field property="SDate" depends="required">
                <arg0 key="이벤트 시작일" resource="false"/>
            </field>

            <field property="EDate" depends="required,dateAfterOrEqual">
                <arg0 key="이벤트 종료일" resource="false"/>
                <arg1 name="dateAfterOrEqual" key="이벤트 시작일" resource="false"/>
                <var><var-name>compareProperty</var-name><var-value>SDate</var-value></var>
            </field>

            <field property="dsc" depends="required">
                <arg0 key="이벤트 내용" resource="false"/>
            </field>

            <field property="address" depends="maxlength">
                <arg0 key="이벤트 주소" resource="false"/>
                <arg1 name="maxlength" key="500" resource="false"/>
                <var><var-name>maxlength</var-name><var-value>500</var-value></var>
            </field>
            <field property="lat" depends="double,floatRange">
                <arg0 key="위도" resource="false"/>
                <arg1 name="floatRange" key="-90" resource="false"/>
                <arg2 name="floatRange" key="90" resource="false"/>
                <var><var-name>min</var-name><var-value>-90</var-value></var>
                <var><var-name>max</var-name><var-value>90</var-value></var>
            </field>

            <field property="lon" depends="double,floatRange">
                <arg0 key="경도" resource="false"/>
                <arg1 name="floatRange" key="-180" resource="false"/>
                <arg2 name="floatRange" key="180" resource="false"/>
                <var><var-name>min</var-name><var-value>-180</var-value></var>
                <var><var-name>max</var-name><var-value>180</var-value></var>
            </field>
            <field property="fileId" depends="long">
                <arg0 key="파일 ID" resource="false"/>
            </field>
        </form>
    </formset>
</form-validation>
