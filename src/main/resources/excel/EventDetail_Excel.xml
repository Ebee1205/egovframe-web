<?xml version="1.0" encoding="UTF-8"?>
<!-- D:/document/files/template/sample.xlsx의 8행 배치와 병합 범위를 기준으로 한다. -->
<excel version="1">
    <sheet name="이벤트 상세" defaultRowHeight="16.5">
        <column index="1" width="12"/>
        <column index="2" width="14"/>
        <column index="3" width="20"/>
        <column index="4" width="14"/>
        <column index="5" width="20"/>
        <cell range="A1" text="이벤트 제목"/>
        <cell range="B1:E1" property="event.title" align="center"/>
        <cell range="A2" text="이벤트 카테고리"/>
        <cell range="B2:E2" property="categoryName" align="center"/>
        <cell range="A3" text="이벤트 지역"/>
        <cell range="B3:E3" property="event.regName" align="center"/>
        <cell range="A4" text="이벤트 주소"/>
        <cell range="B4:E4" property="event.address" align="left"/>
        <cell range="A5" text="이벤트 기간"/>
        <cell range="B5" text="시작일"/>
        <cell range="C5" property="event.SDate" format="yyyy-mm-dd hh:mm" align="center"/>
        <cell range="D5" text="종료일"/>
        <cell range="E5" property="event.EDate" format="yyyy-mm-dd hh:mm" align="center"/>
        <cell range="A6:E6" text="이벤트 내용"/>
        <cell range="A7:E7" property="event.dsc" align="left" vertical="top" height="120"/>
        <cell range="A8" text="이벤트 상태"/>
        <cell range="B8:E8" property="statusName" align="center"/>
    </sheet>
</excel>
