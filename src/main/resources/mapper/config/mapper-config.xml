<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN" "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>

	<!--Mybatis 설정 -->
	<settings>
		<!-- 전통적인 데이터베이스 컬럼명 형태인 A_COLUMN을 CamelCase형태의 자바 프로퍼티명 형태인 aColumn으로 자동으로 매핑하도록 함 -->
		<setting name="mapUnderscoreToCamelCase" value="true"></setting>
		<!--  파라미터에 Null 값이 있을 경우 에러 처리 -->
		<setting name="jdbcTypeForNull" value="VARCHAR"></setting>
	</settings>
	
	<!-- Type Aliases 설정-->
	<typeAliases>
		<typeAlias alias="egovMap" 			type="org.egovframe.rte.psl.dataaccess.util.EgovMap" />
		
		<typeAlias alias="UserVO"			 type="com.user.service.UserVO" />
		<typeAlias alias="UserFilterVO" type="com.user.service.UserFilterVO" />
		<typeAlias alias="MeVO"				 type="com.user.service.MeVO" />
		<typeAlias alias="CodeVO"			 type="com.code.service.CodeDetailVO" />
		<typeAlias alias="CodeFilterVO"		 type="com.code.service.CodeFilterVO" />
		<typeAlias alias="EventVO"			 type="com.event.service.EventVO" />
		<typeAlias alias="EventFilterVO" type="com.event.service.EventFilterVO" />
		<typeAlias alias="EventCmtVO"			 type="com.event.service.EventCmtVO" />
		<typeAlias alias="EventCmtFilterVO" type="com.event.service.EventCmtFilterVO" />
	</typeAliases>

	<mappers>
		<mapper resource="mapper/service/User_SQL.xml" />
		<mapper resource="mapper/service/Me_SQL.xml" />
		<mapper resource="mapper/service/Code_SQL.xml" />
		<mapper resource="mapper/service/CodeUse_SQL.xml" />
		<mapper resource="mapper/service/Event_SQL.xml" />
		<mapper resource="mapper/service/EventCmt_SQL.xml" />
	</mappers>
    
</configuration>
