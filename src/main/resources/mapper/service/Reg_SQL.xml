<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="regDAO">

	<resultMap id="regResultMap" type="RegVO">
		<id property="reg_id" column="reg_id"/>
		<result property="parentRegId" column="p_reg_id"/>
		<result property="parentCode" column="p_code"/>
		<result property="parentName" column="p_name"/>
		<result property="code" column="code"/>
		<result property="name" column="name"/>
		<result property="level" column="level"/>
		<result property="geom" column="geom"/>
		<result property="status" column="status"/>
		<result property="cDate" column="c_date"/>
		<result property="uDate" column="u_date"/>
	</resultMap>

	<sql id="regColumns">
		c.reg_id, c.p_reg_id, c.code, c.name, c.level, c.status, c.c_date, c.u_date,
		p.code AS p_code, p.name AS p_name
	</sql>

	<select id="selectReg" parameterType="RegVO" resultMap="regResultMap">
		SELECT <include refid="regColumns"/>, ST_AsEWKT(c.geom) AS geom
		FROM tb_reg c
		LEFT JOIN tb_reg p ON p.reg_id = c.p_reg_id
		WHERE c.reg_id = #{reg_id}
	</select>

	<sql id="regListWhere">
		<where>
			<if test="parentRegId != null">
				AND c.p_reg_id = #{parentRegId}
			</if>
			<if test="code != null and code != ''">
				AND c.code = #{code}
			</if>
			<if test="name != null and name != ''">
				AND c.name LIKE '%' || #{name} || '%'
			</if>
			<if test="level != null">
				AND c.level = #{level}
			</if>
			<if test="status != null and status != ''">
				AND c.status = #{status}
			</if>
		</where>
	</sql>

	<select id="selectRegList" parameterType="RegVO" resultMap="regResultMap">
		SELECT <include refid="regColumns"/>
		FROM tb_reg c
		LEFT JOIN tb_reg p ON p.reg_id = c.p_reg_id
		<include refid="regListWhere"/>
		ORDER BY c.level, c.p_reg_id NULLS FIRST, c.reg_id
		<if test="pageSize > 0">
			LIMIT #{pageSize} OFFSET #{firstIndex}
		</if>
	</select>

	<select id="selectRegListCnt" parameterType="RegVO" resultType="int">
		SELECT COUNT(*)
		FROM tb_reg c
		<include refid="regListWhere"/>
	</select>

</mapper>
