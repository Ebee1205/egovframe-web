<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="meDAO">

    <resultMap id="meResultMap" type="MeVO">
        <id property="uid" column="uid"/>
        <result property="email" column="email"/>
        <result property="nickname" column="nickname"/>
        <result property="type" column="type"/>
        <result property="status" column="status"/>
        <result property="rid" column="rid"/>
    </resultMap>

    <sql id="meColumns">
        uid, email, nickname, type, status, rid
    </sql>

    <select id="selectMe" parameterType="long" resultMap="meResultMap">
        SELECT <include refid="meColumns"/>
        FROM tb_users
        WHERE uid = #{uid}
    </select>

    <select id="selectMeList" resultMap="meResultMap">
        SELECT <include refid="meColumns"/>
        FROM tb_users
        ORDER BY uid ASC
    </select>
</mapper>
