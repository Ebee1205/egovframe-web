<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="userDAO">

    <resultMap id="userResultMap" type="UserVO">
        <id property="uid" column="uid"/>
        <result property="email" column="email"/>
        <result property="pwd" column="pwd"/>
        <result property="nickname" column="nickname"/>
        <result property="type" column="type"/>
        <result property="status" column="status"/>
        <result property="rid" column="rid"/>
        <result property="cDate" column="c_date"/>
        <result property="uDate" column="u_date"/>
    </resultMap>

    <sql id="userColumns">
        uid, email, pwd, nickname, type, status, rid, c_date, u_date
    </sql>

    <select id="selectUser" parameterType="UserVO" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM tb_users
        WHERE uid = #{uid}
    </select>

    <select id="selectUserList" parameterType="UserVO" resultMap="userResultMap">
        SELECT <include refid="userColumns"/>
        FROM tb_users
        <where>
            <if test="email != null and email != ''">
                AND email = #{email}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="rid != null">
                AND rid = #{rid}
            </if>
        </where>
        ORDER BY uid DESC
    </select>

    <insert id="insertUser" parameterType="UserVO">
        INSERT INTO tb_users (
            email, pwd, nickname, type, status, rid, c_date, u_date
        ) VALUES (
            #{email}, #{pwd}, #{nickname}, #{type}, #{status}, #{rid},
            COALESCE(#{cDate, jdbcType=TIMESTAMP}, CURRENT_TIMESTAMP),
            COALESCE(#{uDate, jdbcType=TIMESTAMP}, CURRENT_TIMESTAMP)
        )
        <selectKey keyProperty="uid" resultType="long" order="AFTER">
            SELECT currval(pg_get_serial_sequence('tb_users', 'uid'))
        </selectKey>
    </insert>

    <update id="updateUser" parameterType="UserVO">
        UPDATE tb_users
        SET email = #{email},
            pwd = #{pwd},
            nickname = #{nickname},
            type = #{type},
            status = #{status},
            rid = #{rid},
            u_date = CURRENT_TIMESTAMP
        WHERE uid = #{uid}
    </update>

    <delete id="deleteUser" parameterType="UserVO">
        DELETE FROM tb_users
        WHERE uid = #{uid}
    </delete>

</mapper>
